<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp">

    <!-- FrameLayout to overlay 3-dot menu -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Existing horizontal content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/category_photo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:contentDescription="Profile Image"
                android:outlineProvider="background"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_menu_outline"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#F3F3F3"
                android:padding="16sp"
                app:tint="@color/bol_color" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/category_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="----"
                    android:textColor="#6B7280"
                    android:textSize="10dp" />

                <TextView
                    android:id="@+id/category_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---- ----"
                    android:textColor="#1F2937"
                    android:textSize="14sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/category_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_background"
                    android:elevation="4dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_margin="2dp"
                    android:text="---"
                    android:textColor="#2E7D32"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <!-- Three-dot menu at top-right -->
        <ImageView
            android:id="@+id/btn_more"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="16dp"
            android:layout_gravity="end|top"
            android:src="@drawable/ic_menu_dot"
            android:contentDescription="More Options"
            app:tint="@color/black"
            android:padding="4dp" />

    </FrameLayout>
</androidx.cardview.widget.CardView>
