<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Inventory.AddProduct">

    <RelativeLayout
        android:id="@+id/add_product_toolbar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/rounded_background_6dp"
        android:backgroundTint="#fafafa"
        android:elevation="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_left_arrow_line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Add Product"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/add_product_toolbar"
        android:fillViewport="true"
        android:scrollbars="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/choose_photo"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:elevation="10dp"
                app:cardCornerRadius="100dp"
                app:cardPreventCornerOverlap="true"
                app:cardUseCompatPadding="true">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Selected Photo -->
                    <ImageView
                        android:id="@+id/show_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <!-- Add Photo Icon -->
                    <ImageView
                        android:id="@+id/choose_photo_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add_photo" />

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <AutoCompleteTextView
                    android:id="@+id/category_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Category"
                    android:inputType="none"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:text="Choose Color"
                android:textColor="@color/bol_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/color_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- BLACK -->
                    <LinearLayout
                        android:id="@+id/color_black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#FAFAFA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10sp">

                        <View
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Black"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- WHITE -->
                    <LinearLayout
                        android:id="@+id/color_white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#FAFAFA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10sp">

                        <View
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="White"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- RED -->
                    <LinearLayout
                        android:id="@+id/color_red"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#FAFAFA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10sp">

                        <View
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#F44336" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Red"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- BLUE -->
                    <LinearLayout
                        android:id="@+id/color_blue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#FAFAFA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10sp">

                        <View
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#2196F3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Blue"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- GREEN -->
                    <LinearLayout
                        android:id="@+id/color_green"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#FAFAFA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10sp">

                        <View
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#4CAF50" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Green"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- YELLOW -->
                    <LinearLayout
                        android:id="@+id/color_yellow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#FAFAFA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10sp">

                        <View
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#FFEB3B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Yellow"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- ORANGE -->
                    <LinearLayout
                        android:id="@+id/color_orange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#FAFAFA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10sp">

                        <View
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#FF9800" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Orange"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- PURPLE -->
                    <LinearLayout
                        android:id="@+id/color_purple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#FAFAFA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10sp">

                        <View
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#9C27B0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Purple"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- PINK -->
                    <LinearLayout
                        android:id="@+id/color_pink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#FAFAFA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10sp">

                        <View
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#E91E63" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Pink"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- BROWN -->
                    <LinearLayout
                        android:id="@+id/color_brown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#FAFAFA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10sp">

                        <View
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#795548" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Brown"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- GRAY -->
                    <LinearLayout
                        android:id="@+id/color_gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#FAFAFA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10sp">

                        <View
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#9E9E9E" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Gray"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- CYAN -->
                    <LinearLayout
                        android:id="@+id/color_cyan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="#FAFAFA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10sp">

                        <View
                            android:layout_width="12sp"
                            android:layout_height="12sp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/rounded_background"
                            android:backgroundTint="#00BCD4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Cyan"
                            android:textSize="12sp" />
                    </LinearLayout>


                    <!-- Add more colors same style -->

                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:text="About"
                android:textColor="@color/bol_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#f4f4f4"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="10sp"
                    android:src="@drawable/ic_pen_black"
                    app:tint="@color/bol_color" />

                <EditText
                    android:id="@+id/product_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overlay"
                    android:hint="Name(brand)"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#f4f4f4"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="10sp"
                    android:src="@drawable/ic_pen_black"
                    app:tint="@color/bol_color" />

                <EditText
                    android:id="@+id/product_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overlay"
                    android:hint="Model(xyz-123)"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textSize="12sp" />
            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:text="Price"
                android:textColor="@color/bol_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#f4f4f4"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="10sp"
                    android:src="@drawable/ic_price"
                    app:tint="@color/bol_color" />

                <EditText
                    android:id="@+id/product_cost_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overlay"
                    android:hint="Cost Price"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#f4f4f4"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="10sp"
                    android:src="@drawable/ic_price"
                    app:tint="@color/bol_color" />

                <EditText
                    android:id="@+id/product_sell_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overlay"
                    android:hint="Selling Price"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textSize="12sp" />
            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:text="Unit"
                android:textColor="@color/bol_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#f4f4f4"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="10sp"
                    android:src="@drawable/ic_box"
                    app:tint="@color/bol_color" />

                <EditText
                    android:id="@+id/product_unit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overlay"
                    android:hint="Unit(meter, litre, gram, kg, cartoon, pcs...)"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/product_create"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10sp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#DAFDDA"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Create product"
                    android:textColor="@color/green"
                    android:textSize="12sp"
                    android:textStyle="bold" />


            </LinearLayout>


        </LinearLayout>


    </ScrollView>

</RelativeLayout>