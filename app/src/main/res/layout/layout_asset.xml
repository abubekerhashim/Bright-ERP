<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <!-- Product Image -->

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:padding="12dp"
                app:cardCornerRadius="16dp"
                app:cardPreventCornerOverlap="true"
                app:cardUseCompatPadding="true">

                <ImageView
                    android:id="@+id/asset_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_loading" />

            </androidx.cardview.widget.CardView>


            <!-- Product Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/asset_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Modern Sofa"
                    android:textColor="@android:color/black"
                    android:textSize="14dp" />

                <TextView
                    android:id="@+id/asset_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Comfortable and stylish sofa."
                    android:textColor="@color/dry_black"
                    android:textSize="12dp" />

                <TextView
                    android:id="@+id/asset_assigned_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Assigned to: Abubeker Hashim"
                    android:textColor="@color/dry_black"
                    android:textSize="10dp" />

                <TextView
                    android:id="@+id/asset_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_background"
                    android:backgroundTint="#E6F7EE"
                    android:padding="6dp"
                    android:text="SARA-FA_00001"
                    android:textColor="#10B981"
                    android:textSize="12dp" />


            </LinearLayout>

            <!-- Action Buttons -->
            <ImageView
                android:id="@+id/btn_more"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:padding="4dp"
                android:src="@drawable/ic_menu_dot"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/assigning_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <TextView
                android:id="@+id/assigned_at"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assigned at: "
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/assigned_by"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assigned by: "
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/assigned_by_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assigned by ID: "
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/assign_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assign Status: "
                android:textSize="10sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10sp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_asset_accept"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:background="@drawable/rounded_background"
                    android:backgroundTint="#DDFDEB"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_margin="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/green" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/green"
                        android:textSize="11dp"
                        android:textStyle="bold"
                        android:text="Accept"/>


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_asset_reject"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:background="@drawable/rounded_background"
                    android:backgroundTint="#FFECE7"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_margin="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_reject"
                        app:tint="@color/red" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/red"
                        android:textSize="11dp"
                        android:textStyle="bold"
                        android:text="Reject"/>


                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
