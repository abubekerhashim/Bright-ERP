<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fafafa"
    tools:context=".Employees.RegisterEmployee">

    <RelativeLayout
        android:id="@+id/register_user_toolbar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:elevation="6dp"
        android:background="@drawable/rounded_background_6dp"
        android:backgroundTint="#fafafa"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_left_arrow_line"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Register Employee"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="14sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_below="@id/register_user_toolbar"
        android:layout_marginTop="10dp"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#fafafa"
                android:layout_margin="6dp"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:text="📌 Position"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/position_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>


            <androidx.cardview.widget.CardView
                android:id="@+id/choose_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_background"
                android:backgroundTint="@color/white"
                android:elevation="4dp"
                app:cardCornerRadius="100dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/show_photo"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:visibility="invisible"
                    android:src="@drawable/ic_add_photo"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:id="@+id/choose_photo_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_add_photo"
                    android:layout_gravity="center"/>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_margin="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_margin="2dp"
                android:backgroundTint="#f4f4f4"
                android:background="@drawable/rounded_background"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="10sp"
                    android:src="@drawable/ic_person_outline"
                    app:tint="@color/bol_color" />

                <EditText
                    android:id="@+id/edt_first_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overlay"
                    android:hint="First Name"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_margin="2dp"
                android:backgroundTint="#f4f4f4"
                android:background="@drawable/rounded_background"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="10sp"
                    android:src="@drawable/ic_person_outline"
                    app:tint="@color/bol_color" />

                <EditText
                    android:id="@+id/edt_middle_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overlay"
                    android:hint="Middle Name"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_margin="2dp"
                android:backgroundTint="#f4f4f4"
                android:background="@drawable/rounded_background"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="10sp"
                    android:src="@drawable/ic_person_outline"
                    app:tint="@color/bol_color" />

                <EditText
                    android:id="@+id/edt_last_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overlay"
                    android:hint="Last Name"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gender"
                android:textSize="12dp"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginStart="10sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/gender_woman"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:backgroundTint="#fafafa"
                    android:background="@drawable/rounded_background"
                    android:elevation="4dp"
                    android:layout_margin="4dp"
                    android:padding="10sp"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_woman"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp"
                        android:text="Woman"/>


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/gender_man"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#fafafa"
                    android:gravity="center"
                    android:background="@drawable/rounded_background"
                    android:elevation="4dp"
                    android:layout_margin="4dp"
                    android:padding="10sp"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_man"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp"
                        android:text="Man"/>


                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textSize="12dp"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginStart="10sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_margin="2dp"
                android:backgroundTint="#f4f4f4"
                android:background="@drawable/rounded_background"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="10sp"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/bol_color" />

                <EditText
                    android:id="@+id/edt_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overlay"
                    android:hint="09xxxxxxxx"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address"
                android:textSize="12dp"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginStart="10sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_margin="2dp"
                android:backgroundTint="#f4f4f4"
                android:background="@drawable/rounded_background"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="10sp"
                    android:src="@drawable/ic_locatio_vec"
                    app:tint="@color/bol_color" />

                <EditText
                    android:id="@+id/edt_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overlay"
                    android:hint="City"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_margin="2dp"
                android:backgroundTint="#f4f4f4"
                android:background="@drawable/rounded_background"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="10sp"
                    android:src="@drawable/ic_locatio_vec"
                    app:tint="@color/bol_color" />

                <EditText
                    android:id="@+id/edt_subcity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overlay"
                    android:hint="Sub City"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_margin="2dp"
                android:backgroundTint="#f4f4f4"
                android:background="@drawable/rounded_background"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="10sp"
                    android:src="@drawable/ic_locatio_vec"
                    app:tint="@color/bol_color" />

                <EditText
                    android:id="@+id/edt_hno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overlay"
                    android:hint="Home number"
                    android:inputType="number"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textSize="14sp" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/btn_register"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#DAFDDA"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_margin="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/green" />
                <TextView
                    android:id="@+id/reg_button_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="Register"/>


            </LinearLayout>



        </LinearLayout>

    </ScrollView>


    <!-- Loading Overlay -->
    <RelativeLayout
        android:id="@+id/loading_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

    </RelativeLayout>




</RelativeLayout>