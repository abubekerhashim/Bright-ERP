<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Assets.AssetDetail">

    <RelativeLayout
        android:id="@+id/asset_detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/white"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/product_detail_back"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_left_arrow_line"
            app:tint="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Detail"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"/>


    </RelativeLayout>

    <ImageView
        android:id="@+id/asset_image"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:backgroundTint="@color/white"
        android:padding="12dp"
        android:layout_below="@+id/asset_detail_toolbar"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_loading" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/buttons_layout"
        android:padding="4dp"
        android:layout_below="@+id/asset_image">


        <LinearLayout
            android:id="@+id/asset_detail_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_background"
            android:backgroundTint="@color/white"
            android:elevation="2dp"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:padding="16dp">


            <TextView
                android:id="@+id/asset_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="13dp"
                android:textColor="#27AE60"
                android:background="@drawable/rounded_background"
                android:backgroundTint="@color/cardBackground"
                android:layout_gravity="end"
                android:elevation="4dp"
                android:layout_margin="2dp"
                android:padding="8dp"/>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/asset_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category: "
                    android:textColor="@color/bol_color"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/asset_reg_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="----"
                    android:layout_marginEnd="10dp"
                    android:textColor="@color/grey"
                    android:textSize="12sp" />

            </LinearLayout>




            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/asset_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="----"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/btn_history"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/rounded_background"
                    android:backgroundTint="#E4E4E4"
                    android:elevation="2dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_history"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#715942" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐⭐⭐⭐⭐"
                android:textSize="14sp"
                android:textColor="#FFC94A"/>

            <TextView
                android:id="@+id/asset_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="-----"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/asset_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location: ------"
                android:layout_marginTop="30dp"
                android:textColor="@color/bol_color"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/asset_assigned_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assigned To: Maintenance Department"
                    android:textColor="@color/bol_color"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />


            </LinearLayout>



        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_assign"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:background="@drawable/rounded_background"
            android:backgroundTint="#DDFDEB"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_margin="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_attach"
                app:tint="@color/green" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:text="Assign"/>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_damage_report"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:background="@drawable/rounded_background"
            android:backgroundTint="#FFFAC9"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_margin="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_alert"
                app:tint="@color/orange" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/orange"
                android:textSize="12sp"
                android:text="Damage Report"/>


        </LinearLayout>


    </LinearLayout>


</RelativeLayout>